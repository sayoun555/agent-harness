#!/usr/bin/env bash
#
# harness — 범용 에이전트 하네스의 단일 진입점.
#   각 명령은 commands/<name>.sh 에 있고, 이 파일은 넘겨 주기만 한다.
#
set -euo pipefail

HARNESS_HOME="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export HARNESS_HOME

usage() {
  cat >&2 <<'EOF'
사용: harness <명령> [인자...]

  init [--preset 이름]       이 프로젝트에 하네스를 끼운다 (.harness/ 생성)
  check [--staged | --all | 파일...]  결정론 게이트 (인자 없으면 기준 대비 바뀐 파일): stub·시크릿(차단), 크기(경고)
  test-guard [기준-ref]       테스트 약화 감시 (기본 기준: HEAD)
  feature <하위명령>          기능 원장: list·next·add·verify·reject·commit·approve·reset·status·audit
  risk [--json]               승인이 필요한 위험 파일 변경 목록
  design <하위명령>           설계 단계: criteria·new·check·review-context·features·import
  mcp [--json]                프리셋이 권하는 MCP 연결 상태 (설치하지 않음)
  figma [컴포넌트]            Figma 시각 충실도 렌즈 (UI 전용, UIMatch)
  run ID                      실행 렌즈: 설치·실행·화면 캡처·로그 (runtime.enabled 면 verify 의 마지막 게이트)
  config [-r] [jq-경로]       병합된 최종 설정
  loop <run|schedule>         사람 없이 루프 실행 (할 일 없으면 토큰 0), cron 줄 출력
  baseline <save|show>        커밋 없이 운용할 때의 비교 기준 (git 트리, 커밋 아님)
  lock run -- <명령>          빌드 잠금을 잡고 실행 (같은 트리 병렬)
  prompt <implement|review> ID   구현자·검증자 표준 프롬프트 (루프·스킬·사람이 같은 것을 쓴다)
  criteria <list|show|add>    검증 기준 (공통 · 스택 · .harness/criteria/ 프로젝트 기준)
  review [--context 기능ID | 파일...]  의미 적대자 (LLM CLI) 또는 적대자용 컨텍스트 출력
  trace [show|tail N]         루프 실행 기록
  ci                          CI 한 번에: check --all + compile + test
  hook <session|pre-edit|post-edit|stop>   에디터 훅 어댑터 (Claude·Codex)
  path <home|workflow>        하네스 경로 출력
EOF
}

main() {
  local command="${1:-}"
  [[ -z "$command" || "$command" == "-h" || "$command" == "--help" ]] && { usage; exit 0; }
  shift

  local script="$HARNESS_HOME/commands/$command.sh"
  [[ -f "$script" ]] || { printf 'harness: 알 수 없는 명령: %s\n\n' "$command" >&2; usage; exit 2; }
  exec bash "$script" "$@"
}

main "$@"

{
  "_about": "Java 21 / Spring Boot / Gradle. 스택 전용 판단 기준과 footgun 은 코어가 아니라 여기에 둔다.",
  "source": {
    "extensions": [
      "java",
      "kt"
    ]
  },
  "build": {
    "compileCommand": "./gradlew compileJava --console=plain -q",
    "testCommand": "./gradlew test --console=plain -q"
  },
  "rules": {
    "maxFileLines": 200,
    "stubMarkerPattern": "(//|/\\*|\\*)[[:space:]]*(TODO|FIXME|XXX|HACK|stub|STUB|placeholder|미구현)|throw new UnsupportedOperationException|throw new RuntimeException\\(\"Not implemented",
    "hardcodePatterns": [
      {
        "id": "hardcoded-url",
        "pattern": "\"https?://[^\"$]+\"",
        "message": "하드코딩된 URL — 설정의 ${...} 참조로 (B8)"
      },
      {
        "id": "magic-port",
        "pattern": "\"(localhost|127\\.0\\.0\\.1):[0-9]{2,5}\"",
        "message": "하드코딩된 호스트·포트 — 설정으로 (B8)"
      }
    ],
    "maxPublicMethods": 7,
    "forbiddenImports": [
      {
        "id": "domain-outer-layer",
        "files": "*/domain/*.java",
        "pattern": "^import[[:space:]]+([A-Za-z0-9_]+\\.)+(infrastructure|api|application|web|controller)\\.",
        "message": "도메인이 바깥 레이어를 import 한다 — 의존성 방향 (B2)",
        "severity": "warn"
      },
      {
        "id": "domain-spring-web",
        "files": "*/domain/*.java",
        "pattern": "^import[[:space:]]+org\\.springframework\\.(web|http)\\.",
        "message": "도메인이 웹 계층에 의존한다 (B2)",
        "severity": "warn"
      },
      {
        "id": "application-infra",
        "files": "*/application/*.java",
        "pattern": "^import[[:space:]]+([A-Za-z0-9_]+\\.)+(infrastructure|api|web|controller)\\.",
        "message": "Application 이 인프라·API 를 직접 import 한다 — 도메인 인터페이스로 받는다 (B2)",
        "severity": "warn"
      }
    ]
  },
  "testGuard": {
    "testCasePattern": "@(Test|ParameterizedTest|RepeatedTest)\\b",
    "assertionPattern": "\\b(assert[A-Z][A-Za-z]*|assertThat|verify|then)\\(",
    "skipPattern": "@Disabled\\b"
  },
  "review": {
    "scopeGlobs": [
      "*/src/main/java/*.java",
      "*/src/main/kotlin/*.kt"
    ],
    "guidance": [],
    "footguns": [
      {
        "id": "tx-self-invocation",
        "sev": "high",
        "check": "@Transactional이 private 메서드나 같은 클래스 자기호출(this.)에 걸리면 프록시를 우회해 트랜잭션이 걸리지 않는다. 별도 빈의 public 메서드로 분리해야 한다."
      },
      {
        "id": "tx-external-call",
        "sev": "high",
        "check": "@Transactional 안에서 외부 API(결제·HTTP)를 호출하면 커넥션을 점유하고 롤백할 수 없다. 외부 호출은 트랜잭션 밖에서, 보상 트랜잭션으로."
      },
      {
        "id": "proxy-self-invocation-async-cache",
        "sev": "med",
        "check": "@Async·@Cacheable·@Retryable도 자기호출이면 프록시 우회로 무효다."
      },
      {
        "id": "jpa-n-plus-1-lazy",
        "sev": "med",
        "check": "루프 안의 lazy 연관 접근(N+1), 트랜잭션 밖 lazy 초기화(LazyInitializationException)."
      },
      {
        "id": "kafka-ack-paths",
        "sev": "med",
        "check": "수동 ack가 정상·예외 모든 경로에서 호출되나. @KafkaListener가 예외를 삼켜 DLT·재시도를 우회하지 않나."
      }
    ],
    "criteria": [
      "backend.md",
      "backend-code.md"
    ]
  },
  "approval": {
    "riskGlobs": [
      "*payment*",
      "*Payment*",
      "*auth*",
      "*Auth*",
      "*security*",
      "*Jwt*",
      "*db/migration*",
      "*flyway*",
      "*liquibase*"
    ]
  },
  "design": {
    "criteria": [
      "common.md",
      "backend.md"
    ]
  }
}
